# =======================================================
# MindVerse Inclusive Learning Lab — Environment Configuration
# =======================================================

# Flask & Security
SECRET_KEY=mindverse-secret-key-2026-inclusive-learning-production
FLASK_ENV=production
PORT=5000

# -------------------------------------------------------
# Primary Relational Database (PostgreSQL / Supabase / Railway Postgres)
# -------------------------------------------------------
# If left blank, MindVerse automatically uses local SQLite.
# Supabase Pooler URI:
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Railway Postgres URI:
# DATABASE_URL=postgresql://postgres:[password]@monorail.proxy.rlwy.net:[port]/railway
DATABASE_URL=

# -------------------------------------------------------
# MongoDB Atlas ("mango db") Cloud Database
# -------------------------------------------------------
# Used for persistent cloud storage of registered students,
# community feedback, video catalogs, and activity records.
# Connection String from MongoDB Atlas (Drivers > Python):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=
MONGO_DB_NAME=mindverse

# Python Version for Cloud Platforms
PYTHON_VERSION=3.11.8

